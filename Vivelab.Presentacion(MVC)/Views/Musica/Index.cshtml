@model IEnumerable<Vivelab.Modelos.Cancion>

@{
    ViewData["Title"] = "Listado de Canciones";
    var plan = ViewBag.PlanCodigo ?? 0;
    var reproducciones = ViewBag.ReproduccionesHoy ?? 0;
    var descargasHoy = ViewBag.DescargasHoy ?? 0;
    var limiteDescargas = ViewBag.LimiteDescargas ?? 0;
}

<script>
    const reproduccionesHoy = @reproducciones;
    const planCodigo = @plan;
    let descargasHoy = @descargasHoy;
    const limiteDescargas = @limiteDescargas;
</script>

<h2>@ViewData["Title"]</h2>

@if (ViewBag.Rol == "artista")
{
    <p>
        <a asp-action="Subir" class="btn btn-primary">
            <i class="bi bi-upload"></i> Subir nueva canción
        </a>
    </p>
}

<div id="bannerAnuncio" class="alert alert-info text-center d-none" style="font-weight: bold;">
    🎙️ Anuncio: Disfruta sin interrupciones con el Plan Premium. ¡Cámbiate ahora!
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Título</th>
            <th>Duración</th>
            <th>Reproducción</th>
            <th>Artista</th>
            <th>Reproducciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.Duracion.ToString(@"hh\:mm\:ss")</td>
                <td>
                    <audio controls class="audio-player" data-id="@item.Codigo" style="max-width:200px;">
                        <source src="@item.ArchivoUrl" />
                        Tu navegador no soporta el elemento
                        <code>audio</code>.
                    </audio>
                    @if (plan != 0)
                    {
                        bool puedeDescargar = descargasHoy < limiteDescargas;
                        <button type="button"
                                class="btn btn-outline-success btn-sm download-btn"
                                data-id="@item.Codigo"
                                @(puedeDescargar ? "" : "disabled")
                                title="@(puedeDescargar ? "Descargar canción" : "Límite alcanzado")">
                            <i class="bi bi-download"></i> Descargar
                        </button>
                    }
                </td>
                <td>@item.Artista.Nombre</td>
                <td>@item.TotalReproducciones</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const banner = document.getElementById("bannerAnuncio");
        let contadorAnuncios = 0;
        let anuncioCada = 3;
        let reproduciendoAnuncio = false;

        document.querySelectorAll('.audio-player').forEach(audio => {
            audio.addEventListener('play', function () {
                if (reproduciendoAnuncio) {
                    this.pause();
                    return;
                }

                if (planCodigo == 0 && reproduccionesHoy >= 10) {
                    this.pause();
                    this.currentTime = 0;
                    alert("Ya alcanzaste tu límite diario de 10 reproducciones en el plan gratuito.");
                    return;
                }

                if (planCodigo == 0 && contadorAnuncios % anuncioCada == 0 && contadorAnuncios !== 0) {
                    this.pause();
                    banner.classList.remove("d-none");
                    reproduciendoAnuncio = true;

                    setTimeout(() => {
                        banner.classList.add("d-none");
                        reproduciendoAnuncio = false;
                        this.play();
                    }, 5000);

                    contadorAnuncios++;
                    return;
                }

                const songId = this.getAttribute('data-id');

                fetch(`/Musica/IncrementarReproduccionUsuario`, {
                    method: 'POST'
                }).then(() => {
                    fetch(`https://localhost:7008/api/Canciones/${songId}/incrementar-reproduccion`, {
                        method: 'POST'
                    }).catch(() => console.error("Error incrementando en API"));
                    reproduccionesHoy++;
                    contadorAnuncios++;
                });
            });

            audio.addEventListener('seeking', function () {
                if (reproduciendoAnuncio) {
                    this.pause();
                    this.currentTime = 0;
                }
            });
        });

        document.querySelectorAll(".download-btn").forEach(btn => {
            btn.addEventListener("click", async function () {
                const id = this.getAttribute("data-id");

                if (descargasHoy >= limiteDescargas) {
                    alert("Has alcanzado tu límite diario de descargas.");
                    this.disabled = true;
                    return;
                }

                try {
                    const response = await fetch(`/Musica/Descargar?cancionId=${id}`);
                    if (!response.ok) {
                        const msg = await response.text();
                        alert("Error: " + msg);
                        return;
                    }

                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `cancion_${id}.mp3`;
                    a.click();
                    window.URL.revokeObjectURL(url);

                    descargasHoy++;
                    if (descargasHoy >= limiteDescargas) {
                        document.querySelectorAll(".download-btn").forEach(b => b.disabled = true);
                    }
                } catch (err) {
                    console.error(err);
                    alert("Error al intentar descargar.");
                }
            });
        });
    </script>
}
