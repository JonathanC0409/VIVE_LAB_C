@model IEnumerable<Vivelab.Modelos.User>

@{
    ViewData["Title"] = "Lista Usuarios";
}

<h2>Lista de Usuarios</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Saldo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Name</td>
                <td>@usuario.Email</td>
                <td>@usuario.Balance</td>
                <td>
                    <a href="@Url.Action("Edit", "Usuario", new { id = usuario.Code })">Editar</a> |
                    <a href="@Url.Action("Delete", "Usuario", new { id = usuario.Code })">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
