@{
    Layout = "_Layout";
    ViewData["Title"] = "Unirse como Artista";
}

<link href="~/css/artist-join.css" rel="stylesheet" asp-append-version="true"/>

<div class="artist-join-container">
    <div class="artist-join-card">
        <div class="artist-header">
            <h1 class="artist-title">
                <i class="fas fa-microphone-alt"></i> Unirse como Artista
            </h1>
            <div class="artist-divider"></div>
            <p class="artist-subtitle">Comparte tu música con el mundo</p>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="artist-alert">
                <i class="fas fa-info-circle"></i> @TempData["Mensaje"]
            </div>
        }

        @if (User.Identity.IsAuthenticated)
        {
            @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "cliente"))
            {
                <div class="artist-benefits">
                    <h3><i class="fas fa-star"></i> Beneficios de ser Artista</h3>
                    <ul>
                        <li><i class="fas fa-check"></i> Sube y gestiona tu música</li>
                        <li><i class="fas fa-check"></i> Conecta con tus fans</li>
                    </ul>
                </div>

                <form method="post" asp-action="CambiarRolUsuario" class="artist-form">
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    <button type="submit" class="artist-join-button">
                        <i class="fas fa-user-astronaut"></i> Convertirme en Artista
                    </button>
                </form>

                <div class="artist-terms">
                    <p>Al hacer clic aceptas nuestros <a href="#">Términos para Artistas</a></p>
                </div>
            }
            
        }
        else
        {
            <div class="artist-login-required">
                <i class="fas fa-sign-in-alt"></i>
                <h3>Inicia sesión para continuar</h3>
                <p>Debes tener una cuenta para unirte como artista.</p>
                <div class="artist-login-actions">
                    <a href="@Url.Action("Index", "Login")" class="artist-login-button">
                        <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                    </a>
                    <a href="@Url.Action("Register", "Login")" class="artist-register-button">
                        <i class="fas fa-user-plus"></i> Registrarse
                    </a>
                </div>
            </div>
        }
    </div>
</div>