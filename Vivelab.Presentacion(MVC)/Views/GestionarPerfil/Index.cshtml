@{
    ViewData["Title"] = "Gestionar Perfil";
}

<link href="~/css/profile.css" rel="stylesheet"  asp-append-version="true"/>

<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <h2 class="profile-title">Gestionar Perfil</h2>
            <div class="profile-avatar">
                <i class="fas fa-user-circle"></i>
            </div>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> @TempData["Mensaje"]
            </div>
        }

        <div class="profile-info">
            <div class="info-item">
                <span class="info-label"><i class="fas fa-user"></i> Nombre:</span>
                <span class="info-value">@User.Identity.Name</span>
            </div>
            <div class="info-item">
                <span class="info-label"><i class="fas fa-envelope"></i> Correo:</span>
                <span class="info-value">@ViewBag.Email</span>
            </div>
            <div class="info-item">
                <span class="info-label"><i class="fas fa-wallet"></i> Saldo:</span>
                <span class="info-value">@ViewBag.Saldo</span>
            </div>
            <div class="info-item">
                <span class="info-label"><i class="fas fa-crown"></i> Plan:</span>
                <span class="info-value">@ViewBag.Plan</span>
            </div>
        </div>

        <div class="profile-sections">
            <!-- Sección Actualizar Nombre -->
            <div class="profile-section">
                <h3 class="section-title"><i class="fas fa-edit"></i> Actualizar Nombre</h3>
                <form method="post" asp-action="ActualizarNombre" class="profile-form">
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    <div class="form-group">
                        <label for="nombre">Nuevo Nombre</label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" id="nombre" name="nombre" value="@User.Identity.Name" required />
                            <i class="fas fa-signature input-icon"></i>
                        </div>
                    </div>
                    <button type="submit" class="btn-profile btn-update">
                        <i class="fas fa-save"></i> Actualizar Nombre
                    </button>
                </form>
            </div>

            <!-- Sección Cambiar Contraseña -->
            <div class="profile-section">
                <h3 class="section-title"><i class="fas fa-key"></i> Cambiar Contraseña</h3>
                <form method="post" asp-action="CambiarPassword" class="profile-form">
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    <div class="form-group">
                        <label for="passwordActual">Contraseña Actual</label>
                        <div class="input-wrapper">
                            <input type="password" class="form-control" id="passwordActual" name="passwordActual" required />
                            <i class="fas fa-lock input-icon"></i>
                            <span toggle="#passwordActual" class="fas fa-eye toggle-password"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="passwordNuevo">Nueva Contraseña</label>
                        <div class="input-wrapper">
                            <input type="password" class="form-control" id="passwordNuevo" name="passwordNuevo" required />
                            <i class="fas fa-lock input-icon"></i>
                            <span toggle="#passwordNuevo" class="fas fa-eye toggle-password"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn-profile btn-change">
                        <i class="fas fa-sync-alt"></i> Cambiar Contraseña
                    </button>
                </form>
            </div>

            <!-- Sección Eliminar Cuenta -->
            <div class="profile-section danger-zone">
                <h3 class="section-title"><i class="fas fa-exclamation-triangle"></i> Zona Peligrosa</h3>
                <div class="danger-content">
                    <p>Esta acción eliminará permanentemente tu cuenta y todos tus datos asociados.</p>
                    <form method="post" asp-action="EliminarCuenta" id="formEliminarCuenta">
                        <input type="hidden" name="email" value="@ViewBag.Email" />
                        <button type="submit" class="btn-profile btn-delete" onclick="return confirmarEliminacion()">
                            <i class="fas fa-trash-alt"></i> Eliminar Cuenta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmarEliminacion() {
        return confirm('¿Estás seguro de que deseas eliminar tu cuenta? Esta acción es irreversible y se perderán todos tus datos.');
    }

    // Toggle para mostrar/ocultar contraseña
    $(document).on('click', '.toggle-password', function() {
        $(this).toggleClass('fa-eye fa-eye-slash');
        var input = $($(this).attr('toggle'));
        if (input.attr('type') == 'password') {
            input.attr('type', 'text');
        } else {
            input.attr('type', 'password');
        }
    });
</script>