@model IEnumerable<Vivelab.Modelos.Song>

<h2>Mis Canciones</h2>
<p>
    <a asp-action="Subir" asp-controller="Musica" class="btn btn-primary">
        <i class="bi bi-upload"></i> Subir nueva canción
    </a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Duracion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cancion in Model)
        {
            <tr>
                <td>@cancion.Title</td>
                <td>@cancion.Duration</td>
                <td>
                    <a href="@Url.Action("EditarCancion", new { id = cancion.Code })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("DeleteSong", new { id = cancion.Code })" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>


