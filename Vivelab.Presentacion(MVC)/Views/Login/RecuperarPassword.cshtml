@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<link href="~/css/recovery.css" rel="stylesheet" asp-append-version="true" />

<div class="recovery-container">
    <div class="recovery-card">
        <h1 class="recovery-title">Recuperar Contraseña</h1>

        <p class="recovery-subtitle">Ingrese su correo electrónico para recibir un enlace de recuperación</p>

        <form method="post" class="recovery-form">
            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <div class="input-wrapper">
                    <input type="email" class="form-control" id="email" name="email" required placeholder="Ingrese su correo electrónico">
                    <i class="fas fa-envelope input-icon"></i>
                </div>
            </div>

            <button type="submit" class="btn-recovery">
                <span class="btn-text">Enviar solicitud</span>
                <i class="fas fa-paper-plane btn-icon"></i>
            </button>

            <div class="back-to-login">
                <a asp-action="Index"><i class="fas fa-arrow-left"></i> Volver al inicio de sesión</a>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
                </div>
            }

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @ViewBag.SuccessMessage
                </div>
            }
        </form>
    </div>
</div>

<!-- Efecto de partículas -->
<div class="recovery-particles">
    @for (int i = 0; i < 15; i++)
    {
        <div class="recovery-particle" style="top: @(new Random().Next(0, 100))%; left: @(new Random().Next(0, 100))%; animation-delay: @(new Random().Next(0, 8))s;"></div>
    }
</div>