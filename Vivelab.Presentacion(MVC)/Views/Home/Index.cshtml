@functions {
    private static readonly Random rnd = new Random();

    public string GetRandomColorClass()
    {
        return $"avatar-color{rnd.Next(1, 7)}";
    }
}

@{
    ViewData["Title"] = "Home";
    var artistas = ViewBag.Artistas as IEnumerable<Vivelab.Modelos.User>;
    var albumes = ViewBag.Albumes as IEnumerable<Vivelab.Modelos.Album>;
    var canciones = ViewBag.Canciones as IEnumerable<Vivelab.Modelos.Song>;
    var topCanciones = ViewBag.TopCanciones as IEnumerable<Vivelab.Modelos.Song>;
}

<link rel="stylesheet" href="~/css/cardHome.css" asp-append-version="true" />

<!-- Background animation -->
<div class="background-animation" id="backgroundAnimation"></div>

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">Vivelab 🎵</h1>
            <p class="hero-subtitle">Descubre y comparte tu música favorita</p>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="welcome-message">¡Hola, @User.Identity.Name! 👋</div>

                <div class="action-buttons">
                    @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "cliente"))
                    {
                        <a href="@Url.Action("CambiarRolUsuario", "GestionarPerfil")" class="btn-modern">
                            🎤 Regístrate como Artista
                        </a>
                        <a href="@Url.Action("TopUpBalance", "Client")" class="btn-modern">
                            💳 Recargar Saldo
                        </a>
                    }
                    @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "artista"))
                    {
                        <a href="@Url.Action("Subir", "Musica")" class="btn-modern">
                            ⬆️ Subir Canción
                        </a>
                    }
                    @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "administrador"))
                    {
                        <a href="@Url.Action("ViewUser", "Administrator")" class="btn-modern">
                            👥 Ver Usuarios
                        </a>
                        <a href="@Url.Action("BlockUser", "Administrator")" class="btn-modern btn-danger-modern">
                            ⚠️ Bloquear Usuario
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container">
    <!-- Artists Section -->
    <h2 class="section-title scroll-animation">🎤 Artistas Populares</h2>
    <div class="carrusel-artistas scroll-animation">
        @foreach (var a in artistas)
        {
            var inicial = !string.IsNullOrEmpty(a.Name) ? a.Name.Substring(0, 1).ToUpper() : "?";
            <div class="tarjeta-artista">
                <div class="avatar @GetRandomColorClass()">
                    @inicial
                </div>
                <p class="nombre">@a.Name</p>
                <p class="rol">Artista</p>
            </div>
        }
    </div>

    <!-- Albums Section -->
    <h2 class="section-title scroll-animation">💿 Álbumes y sencillos populares</h2>
    <div class="carrusel-albumes scroll-animation">
        @foreach (var alb in albumes)
        {
            <div class="tarjeta-album">
                @if (!string.IsNullOrEmpty(alb.CoverUrl))
                {
                    <img src="@Url.Content(alb.CoverUrl)" alt="@alb.Name" />
                }
                else
                {
                    <div class="avatar-album @GetRandomColorClass()">
                        @alb.Name.Substring(0, 1).ToUpper()
                    </div>
                }
                <div class="info">
                    <p class="titulo">@alb.Name</p>
                    <p class="artista">@alb.Artist.Name</p>
                </div>
            </div>
        }
    </div>

    <!-- Songs Section -->
    <h2 class="section-title scroll-animation">🎶 Canciones en tendencia</h2>
    <div class="carrusel-canciones scroll-animation">
        @foreach (var c in canciones)
        {
            <div class="tarjeta-cancion">
                @if (!string.IsNullOrEmpty(c.CoverUrl))
                {
                    <img src="@Url.Content(c.CoverUrl)" alt="@c.Title" />
                }
                else
                {
                    <div class="avatar-cancion @GetRandomColorClass()">
                        @c.Title.Substring(0, 1).ToUpper()
                    </div>
                }
                <div class="info">
                    <p class="titulo">@c.Title</p>
                    <p class="artista">@c.Artist?.Name</p>
                </div>
                <a href="@Url.Action("Player", "Home", new { id = c.Code })" class="boton-play" title="Reproducir">
                    <svg viewBox="0 0 16 16" fill="currentColor">
                        <path d="M4 4l8 4-8 4z" />
                    </svg>
                </a>
            </div>
        }
    </div>

    <!-- Top 5 Section -->
    <h2 class="section-title scroll-animation">🔥 Top 5 Canciones</h2>
    <ol class="lista-top-5 scroll-animation">
        @{
            int pos = 1;
        }
        @foreach (var c in topCanciones)
        {
            <li class="item-top">
                <span class="posicion">@pos</span>
                <div class="portada">
                    @if (!string.IsNullOrEmpty(c.CoverUrl))
                    {
                        <img src="@Url.Content(c.CoverUrl)" alt="@c.Title" />
                    }
                    else
                    {
                        <div class="@GetRandomColorClass()" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:white;font-size:1.2rem;border-radius:12px;">
                            @c.Title.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <div class="info">
                    <p class="titulo">@c.Title</p>
                    <p class="reproducciones">@c.TotalPlays reproducciones</p>
                </div>
                <span class="duracion">@c.Duration.ToString(@"mm\:ss")</span>
                <a href="@Url.Action("Player", "Home", new { id = c.Code })" class="boton-play" title="Reproducir">
                    <svg viewBox="0 0 16 16" fill="currentColor">
                        <path d="M4 4l8 4-8 4z" />
                    </svg>
                </a>
            </li>
            pos++;
        }
    </ol>
</div>

@section Scripts {
    <script src="~/js/cardHome.js" asp-append-version="true"></script>
    <script src="~/js/player.js" asp-append-version="true"></script>
}


