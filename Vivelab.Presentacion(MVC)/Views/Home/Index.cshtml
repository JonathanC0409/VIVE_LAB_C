
@{
    ViewData["Title"] = "Home Page";
    var artistas = ViewBag.Artistas as IEnumerable<Vivelab.Modelos.Usuario>;
    var albumes = ViewBag.Albumes as IEnumerable<Vivelab.Modelos.Album>;
    var canciones = ViewBag.Canciones as IEnumerable<Vivelab.Modelos.Cancion>;
     var topCanciones = ViewBag.TopCanciones as IEnumerable<Vivelab.Modelos.Cancion>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vivelab</title>
    <link rel="stylesheet" href="~/css/cardHome.css" asp-append-version="true"/>


</head>
<body>

    <!-- Sección principal con bienvenida y recomendaciones -->
    <div class="container my-5">
        
        <div class="text-center">
            <h1 class="display-4">Bienvenido a Vivelab 🎵</h1>
            <p class="lead mt-3">Descubre tu música favorita y comparte tus canciones con el mundo.</p>
            

            
            @if (User.Identity.IsAuthenticated)
            {
                <h4 class="mt-3">¡Hola, @User.Identity.Name 👋</h4>
                @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "cliente"))
                {
                    <p class="mt-3">
                        <a href="@Url.Action("CambiarRolUsuario", "GestionarPerfil")" class="btn btn-success btn-lg">Regístrate como Artista</a>
                    </p>
                    <p class="mt-3">
                        <a href="@Url.Action("RecargarSaldo","Usuario")" class="btn btn-success btn-lg">Recargar Saldo</a>
                    </p>
                }

                @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "artista"))
                {
                    <p class="mt-3">
                        <a href="@Url.Action("Subir", "Musica")" class="btn btn-success btn-lg">Subir una canción</a>
                    </p>

                }

                @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "administrador"))
                {
                    <p class="mt-3">
                        <a href="@Url.Action("ListaUsuarios", "Usuario")" class="btn btn-success btn-lg">Ver Usuarios</a>
                    </p>

                    <p class="mt-3">
                        <a href="@Url.Action("BloquearUsuario", "Usuario")" class="btn btn-success btn-lg">Bloquear Usuario</a>
                    </p>

                }


            }
            
        </div>
        
    <h2>Artistas</h2>
    <div class="contenedor-tarjetas">
        @foreach (var a in artistas)
        {
            var inicial = !string.IsNullOrEmpty(a.Nombre)
                    ? a.Nombre.Substring(0,1).ToUpper()
                    : "?";
            <div class="tarjeta">
            @* <div class="imagen-tarjeta"> Se implementara cuadno se incluya la foto del usuario(artista)
              @if (!string.IsNullOrEmpty(a.Foto))
              {
                <img src="@Url.Content(a.RutaImagen)" alt="@a.NombreUsuario" />
              }
              else
              {
                <div class="avatar">@inicial</div>
              }
            </div> *@
             <div class="imagen-tarjeta">
             <div class="avatar">
                 @inicial
             </div>
         </div>
        <p class="titulo-tarjeta">@a.Nombre</p>
      </div>
      }
    </div>
        
    <h2>Álbumes</h2>
<div class="contenedor-tarjetas">
  @foreach(var alb in albumes)
  {
      // Calcula la inicial si no hay imagen
      var inicial = !string.IsNullOrEmpty(alb.Nombre)
                    ? alb.Nombre.Substring(0,1).ToUpper()
                    : "?";

      <div class="tarjeta">
        <div class="imagen-tarjeta">
          @if (!string.IsNullOrEmpty(alb.PortadaUrl))
          {
            <img src="@Url.Content(alb.PortadaUrl)" alt="@alb.Nombre" />
          }
          else
          {
            <div class="avatar">@inicial</div>
          }
        </div>
        <p class="titulo-tarjeta">@alb.Nombre</p>
      </div>
  }
</div>

<h2>Canciones</h2>
<div class="contenedor-tarjetas">
  @foreach (var c in canciones)
  {
      var inicial = !string.IsNullOrEmpty(c.Titulo)
                    ? c.Titulo.Substring(0,1).ToUpper()
                    : "?";
      <div class="tarjeta">
        <div class="imagen-tarjeta">
          @if (!string.IsNullOrEmpty(c.PortadaUrl))
          {
            <img src="@Url.Content(c.PortadaUrl)" alt="@c.Titulo" />
          }
          else
          {
            <div class="avatar">@inicial</div>
          }
        </div>
        <p class="titulo-tarjeta">@c.Titulo</p>
      </div>
  }
</div>

<h2>Canciones más escuchadas (Top 5)</h2>
<ol class="lista-top-canciones">
  @{
      int indice = 1;
  }
  @foreach(var c in topCanciones)
  {
      var inicial = !string.IsNullOrEmpty(c.Titulo)
                    ? c.Titulo.Substring(0,1).ToUpper()
                    : "?";
      <li class="item-lista">
        <span class="numero-lista">@indice.</span>

        @* Avatar o imagen *@
        @if (!string.IsNullOrEmpty(c.PortadaUrl))
        {
          <img class="avatar-lista" src="@Url.Content(c.PortadaUrl)" alt="@c.Titulo" />
        }
        else
        {
          <div class="avatar-lista">@inicial</div>
        }

        @* Info y reproducciones *@
        <div class="info-lista">
          <p class="titulo-lista">@c.Titulo</p>
          <p class="reproducciones-lista">@c.TotalReproducciones reproducciones</p>
        </div>

        @* Duración *@
        <span class="duracion-lista">@c.Duracion.ToString(@"mm\:ss")</span>

        @* Botón play con data-attributes *@
    
<a href="@Url.Action("Player","Home", new { id = c.Codigo })" 
   class="boton-reproducir" title="Reproducir">
  <!-- SVG play -->
  <svg viewBox="0 0 16 16" fill="currentColor">
    <path d="M4 4l8 4-8 4z"/>
  </svg>
</a>

      </li>
      indice++;
  }
</ol>



    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/player.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
