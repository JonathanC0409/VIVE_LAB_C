@functions {
    private static readonly Random rnd = new Random();

    public string GetRandomColorClass()
    {
        return $"avatar-color{rnd.Next(1, 7)}";
    }
}

<link rel="stylesheet" href="~/css/cardHome.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Home";
    var artistas = ViewBag.Artistas as IEnumerable<Vivelab.Modelos.Usuario>;
    var albumes = ViewBag.Albumes as IEnumerable<Vivelab.Modelos.Album>;
    var canciones = ViewBag.Canciones as IEnumerable<Vivelab.Modelos.Cancion>;
    var topCanciones = ViewBag.TopCanciones as IEnumerable<Vivelab.Modelos.Cancion>;
}

<div class="container my-5 text-white">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Bienvenido a Vivelab 🎵</h1>
        <p class="lead">Descubre y comparte tu música favorita.</p>

        @if (User.Identity.IsAuthenticated)
        {
            <h4 class="mt-3">¡Hola, @User.Identity.Name! 👋</h4>

            @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "cliente"))
            {
                <a href="@Url.Action("CambiarRolUsuario", "GestionarPerfil")" class="btn btn-success m-2">Regístrate como Artista</a>
                <a href="@Url.Action("RecargarSaldo", "Usuario")" class="btn btn-success m-2">Recargar Saldo</a>
            }
            @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "artista"))
            {
                <a href="@Url.Action("Subir", "Musica")" class="btn btn-success m-2">Subir Canción</a>
            }
            @if (User.HasClaim(c => c.Type == "TipoUsuario" && c.Value == "administrador"))
            {
                <a href="@Url.Action("ListaUsuarios", "Usuario")" class="btn btn-success m-2">Ver Usuarios</a>
                <a href="@Url.Action("BloquearUsuario", "Usuario")" class="btn btn-danger m-2">Bloquear Usuario</a>
            }
        }
    </div>

    <h2>🎤 Artistas Populares</h2>
    <div class="carrusel-artistas">
        @foreach (var a in artistas)
        {
            var inicial = !string.IsNullOrEmpty(a.Nombre) ? a.Nombre.Substring(0, 1).ToUpper() : "?";
            <div class="tarjeta-artista">
                <div class="imagen">
                    @* @if (!string.IsNullOrEmpty(a.RutaImagen))
                    {
                        <img src="@Url.Content(a.RutaImagen)" alt="@a.Nombre" />
                    }
                    else
                    { *@
                        <div class="avatar @GetRandomColorClass()">
                            @inicial
                        </div>
                   @*  } *@
                </div>
                <p class="nombre">@a.Nombre</p>
                <p class="rol">Artista</p>
            </div>
        }
    </div>


    <h2>💿 Álbumes y sencillos populares</h2>
    <div class="carrusel-albumes">
        @foreach (var alb in albumes)
        {
            <div class="tarjeta-album">
                <div class="imagen">
                    @if (!string.IsNullOrEmpty(alb.PortadaUrl))
                    {
                        <img src="@Url.Content(alb.PortadaUrl)" alt="@alb.Nombre" />
                    }
                    else
                    {
                        <div class="avatar-album @GetRandomColorClass()">
                            @alb.Nombre.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <div class="info">
                    <p class="titulo">@alb.Nombre</p>
                    <p class="artista">@alb.Artista.Nombre</p>
                </div>
            </div>

        }
    </div>


    <h2>🎶 Canciones en tendencia</h2>
    <div class="carrusel-canciones">
        @foreach (var c in canciones)
        {
            <div class="tarjeta-cancion">
                <div class="imagen">
                    @if (!string.IsNullOrEmpty(c.PortadaUrl))
                    {
                        <img src="@Url.Content(c.PortadaUrl)" alt="@c.Titulo" />
                    }
                    else
                    {
                        <div class="avatar-cancion @GetRandomColorClass()">
                            @c.Titulo.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <div class="info">
                    <p class="titulo">@c.Titulo</p>
                    <p class="artista">@c.Artista?.Nombre</p>
                </div>
                <a href="@Url.Action("Player", "Home", new { id = c.Codigo })" class="boton-play" title="Reproducir">
                    <svg viewBox="0 0 16 16" fill="currentColor">
                        <path d="M4 4l8 4-8 4z" />
                    </svg>
                </a>
            </div>
        }
    </div>



    <h2>🔥 Top 5 Canciones</h2>
    <ol class="lista-top-5">
        @{
            int pos = 1;
        }
        @foreach (var c in topCanciones)
        {
            <li class="item-top">
                <span class="posicion">@pos</span>

                <div class="portada">
                    @if (!string.IsNullOrEmpty(c.PortadaUrl))
                    {
                        <img src="@Url.Content(c.PortadaUrl)" alt="@c.Titulo" />
                    }
                    else
                    {
                        <div style="width:100%;height:100%;background:#1db954;display:flex;align-items:center;justify-content:center;color:white;font-size:1.2rem;">
                            @c.Titulo.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>

                <div class="info">
                    <p class="titulo">@c.Titulo</p>
                    <p class="reproducciones">@c.TotalReproducciones reproducciones</p>
                </div>

                <span class="duracion">@c.Duracion.ToString(@"mm\:ss")</span>

                <a href="@Url.Action("Player", "Home", new { id = c.Codigo })" class="boton-play" title="Reproducir">
                    <svg viewBox="0 0 16 16" fill="currentColor">
                        <path d="M4 4l8 4-8 4z" />
                    </svg>
                </a>
            </li>
            pos++;
        }
    </ol>


</div>

@section Scripts {
    <script src="~/js/player.js"></script>
}
