@model IEnumerable<Vivelab.Modelos.Cancion>
@{
    ViewData["Title"] = "Canciones del Álbum";
    var album = ViewBag.Album as Vivelab.Modelos.Album;
    var cancionesDisponibles = ViewBag.CancionesDisponibles as List<Vivelab.Modelos.Cancion>;
}

<link href="~/css/ver-canciones-album.css" rel="stylesheet" asp-append-version="true"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="album-canciones-container">
    <!-- Encabezado del álbum -->
    <div class="album-header">
        @if (!string.IsNullOrEmpty(album.PortadaUrl))
        {
            <img src="@album.PortadaUrl" alt="Portada del álbum" class="album-cover" />
        }
        else
        {
            <div class="album-cover" style="background: rgba(155, 81, 224, 0.1); display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-vinyl" style="font-size: 3rem; color: var(--accent-purple);"></i>
            </div>
        }
        
        <div class="album-info">
            <h1 class="album-title">@album.Nombre</h1>
            <div class="album-meta">
                <span><i class="bi bi-calendar"></i> Creado el: @album.FechaCreacion.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="album-actions">
                <a asp-action="MisAlbumes" class="btn-accion btn-volver">
                    <i class="bi bi-arrow-left"></i> Volver a álbumes
                </a>
            </div>
        </div>
    </div>

    <!-- Canciones del álbum -->
    <h3 class="section-title">
        <i class="bi bi-music-note-list"></i> Canciones (@Model.Count())
    </h3>

    @if (Model.Any())
    {
        <table class="canciones-table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Duración</th>
                    <th>Reproducir</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cancion in Model)
                {
                    <tr>
                        <td>@cancion.Titulo</td>
                        <td>@cancion.Duracion.ToString(@"mm\:ss")</td>
                        <td>
                            <audio controls class="audio-player" data-id="@cancion.Codigo">
                                <source src="@cancion.ArchivoUrl" />
                                Tu navegador no soporta el elemento audio.
                            </audio>
                        </td>
                        <td>
                            <form asp-action="QuitarCancionDeAlbum" method="post" style="display: inline;">
                                <input type="hidden" name="albumId" value="@album.Codigo" />
                                <input type="hidden" name="cancionId" value="@cancion.Codigo" />
                                <button type="submit" class="btn-accion btn-eliminar" onclick="return confirm('¿Quitar esta canción del álbum?')">
                                    <i class="bi bi-trash"></i> Quitar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-music"></i>
            <h4>Este álbum no tiene canciones aún</h4>
            <p>Agrega canciones usando el formulario inferior</p>
        </div>
    }

    <!-- Agregar canciones al álbum -->
    @if (cancionesDisponibles.Any())
    {
        <h3 class="section-title">
            <i class="bi bi-plus-circle"></i> Agregar canciones al álbum
        </h3>

        <form asp-action="AgregarCancion" method="post" class="agregar-cancion-form">
            <input type="hidden" name="albumId" value="@album.Codigo" />
            
            <div class="form-group">
                <label class="form-label">Seleccionar canción para agregar:</label>
                <select style="color:black" name="cancionId" class="form-select" required>
                    <option value="">-- Selecciona una canción --</option>
                    @foreach (var cancion in cancionesDisponibles)
                    {
                        <option value="@cancion.Codigo">@cancion.Titulo (@cancion.Duracion.ToString(@"mm\:ss"))</option>
                    }
                </select>
            </div>
            
            <button type="submit" class="btn-accion btn-agregar">
                <i class="bi bi-plus-lg"></i> Agregar al álbum
            </button>
        </form>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-check-circle"></i>
            <h4>No hay más canciones disponibles</h4>
            <p>Todas tus canciones ya están en este álbum</p>
        </div>
    }
</div>