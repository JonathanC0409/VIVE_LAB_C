@model Vivelab.Modelos.Album

@{
    ViewData["Title"] = "Crear Álbum";
}

<link href="~/css/crear-album.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="crear-album-container">
    <h1 class="crear-album-title">@ViewData["Title"]</h1>
    <h4 class="crear-album-subtitle">Crear un nuevo álbum</h4>
    <span class="title-separator"></span>

    <form asp-action="CrearAlbum" enctype="multipart/form-data" class="album-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Nombre del Álbum -->
        <div class="form-group">
            <label asp-for="Nombre" class="form-label">Nombre del Álbum</label>
            <input asp-for="Nombre" class="form-control" required placeholder="Ej: Mi primer álbum" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <!-- Fecha de Creación (oculta) -->
        <input asp-for="FechaCreacion" type="hidden" value="@DateTime.Now.ToString("yyyy-MM-dd")" />

        <!-- Portada del Álbum -->
        <div class="form-group">
            <label class="form-label">Portada del Álbum</label>
            <div class="file-input-container">
                <label for="PortadaUrl" class="file-input-label">
                    <i class="bi bi-image"></i> Selecciona una imagen
                </label>
                <input asp-for="PortadaUrl" id="PortadaUrl" class="file-input" type="file" accept="image/*" />
                <span class="file-name" id="fileName"></span>
                <span asp-validation-for="PortadaUrl" class="text-danger"></span>
            </div>
        </div>

        <!-- Artista Código (autoasignado) -->
        <input asp-for="ArtistaCodigo" type="hidden" value="@User.FindFirst("UsuarioCodigo")?.Value" />

        <!-- Botones -->
        <div class="btn-container">
            <button type="submit" class="btn-crear">
                <i class="bi bi-plus-circle"></i> Crear Álbum
            </button>
            <a asp-action="MisAlbumes" class="btn-volver">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Mostrar nombre del archivo seleccionado
        document.getElementById('PortadaUrl').addEventListener('change', function(e) {
            const fileName = document.getElementById('fileName');
            if (this.files.length > 0) {
                fileName.textContent = this.files[0].name;
                fileName.style.display = 'block';
            } else {
                fileName.style.display = 'none';
            }
        });
    </script>
}