@model IEnumerable<Vivelab.Modelos.Plan>

@{
    ViewData["Title"] = "Suscripciones por Planes";
}

<link href="~/css/plan.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="suscripciones-container">
    <h1 class="suscripciones-title">@ViewData["Title"]</h1>

    @foreach (var plan in Model)
    {
        <div class="plan-card">
            <!-- Nombre del Plan -->
            <h2><i class="bi bi-collection"></i> @plan.Nombre</h2>

            <!-- Mostrar la cantidad de suscripciones -->
            <p><strong><i class="bi bi-people-fill"></i> Suscripciones:</strong> @plan.Suscripciones.Count()</p>

            <!-- Verificar si el plan tiene suscripciones -->
            @if (plan.Suscripciones != null && plan.Suscripciones.Any())
            {
                <div class="suscripciones-list">
                    <!-- Mostrar cada suscripción como tarjeta -->
                    @foreach (var sub in plan.Suscripciones)
                    {
                        <div class="suscripcion-card">
                            <!-- Mostrar el nombre del Usuario Principal -->
                            <p><strong><i class="bi bi-person-badge"></i> Usuario Principal:</strong> @sub.UsuarioPrincipal?.Nombre</p>
                            <p><strong><i class="bi bi-calendar-event"></i> Fecha Inicio:</strong> @sub.FechaInicio.ToString("dd/MM/yyyy")</p>
                            <p><strong><i class="bi bi-calendar-x"></i> Fecha Fin:</strong> @sub.FechaFin.ToString("dd/MM/yyyy")</p>
                            <p>
                                <strong><i class="bi bi-circle-fill"></i> Estado:</strong>
                                <span class="@GetEstadoClass(sub.Estado)">
                                    @sub.Estado
                                </span>
                            </p>

                            <!-- Mostrar los Usuarios Adicionales -->
                            @if (sub.UsuariosAdicionales != null && sub.UsuariosAdicionales.Any())
                            {
                                <p><strong><i class="bi bi-people"></i> Usuarios Adicionales:</strong></p>
                                <ul>
                                    @foreach (var u in sub.UsuariosAdicionales)
                                    {
                                        <li><i class="bi bi-person"></i> @u.Usuario.Nombre</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p><i class="bi bi-info-circle"></i> No hay usuarios adicionales.</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-suscripciones">
                    <i class="bi bi-exclamation-circle"></i> No hay suscripciones para este plan.
                </div>
            }
        </div>
    }
</div>

@functions {
    string GetEstadoClass(string estado)
    {
        switch (estado.ToLower())
        {
            case "activo":
                return "estado-activo";
            case "inactivo":
                return "estado-inactivo";
            case "cancelado":
                return "estado-cancelado";
            default:
                return "";
        }
    }
}