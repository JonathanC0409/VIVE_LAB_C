@model IEnumerable<Vivelab.Modelos.Plan>

@{
    ViewData["Title"] = "ViewDatesSubcripcionsForPlan";
}
<link rel="stylesheet" href="~/css/plan.css" asp-append-version="true" />

<h1>Suscripciones por Planes</h1>

@foreach(var plan in Model)
{
    <div class="plan-card">
        <!-- Nombre del Plan -->
        <h2>@plan.Nombre</h2>

        <!-- Mostrar la cantidad de suscripciones -->
        <p><strong>Este plan tiene @plan.Suscripciones.Count() suscripciones.</strong></p>

        <!-- Verificar si el plan tiene suscripciones -->
        @if (plan.Suscripciones != null && plan.Suscripciones.Any()) 
        {
            <div class="suscripciones-list">
                <!-- Mostrar cada suscripción como tarjeta -->
                @foreach(var sub in plan.Suscripciones)
                {
                    <div class="suscripcion-card">
                        <!-- Mostrar el nombre del Usuario Principal -->
                        <p><strong>Usuario Principal:</strong> @sub.UsuarioPrincipal?.Nombre</p>
                        <p><strong>Fecha de Inicio:</strong> @sub.FechaInicio.ToString("dd/MM/yyyy")</p>
                        <p><strong>Fecha de Fin:</strong> @sub.FechaFin.ToString("dd/MM/yyyy")</p>
                        <p><strong>Estado:</strong> @(sub.Estado)</p>

                        <!-- Mostrar los Usuarios Adicionales -->
                        @if (sub.UsuariosAdicionales != null && sub.UsuariosAdicionales.Any())
                        {
                            <p><strong>Usuarios Adicionales:</strong></p>
                            <ul>
                                @foreach(var u in sub.UsuariosAdicionales)
                                {
                                    <li>@u.Usuario.Nombre</li>  <!-- Mostrar nombre de cada usuario adicional -->
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No hay usuarios adicionales.</p>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p>No hay suscripciones disponibles para este plan.</p>  <!-- Mensaje si no hay suscripciones -->
        }
    </div>
}
