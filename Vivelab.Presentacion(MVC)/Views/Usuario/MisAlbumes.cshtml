@model IEnumerable<Vivelab.Modelos.Album>

@{
    ViewData["Title"] = "Mis Álbumes";
}

<h2>@ViewData["Title"]</h2>

<a href="@Url.Action("CrearAlbum")" class="btn btn-success mb-3">Crear Nuevo Álbum</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre del Álbum</th>
            <th>Fecha de Creación</th>
            <th>Portada</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var album in Model)
        {
            <tr>
                <td>@album.Name</td>
                <td>@album.CreationDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (!string.IsNullOrEmpty(album.CoverUrl))
                    {
                        <img src="@album.CoverUrl" alt="Portada" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <span>No disponible</span>
                    }
                </td>
                <td>
                    <!-- Ver Canciones -->
                    <a href="@Url.Action("VerCanciones", new { albumId = album.Code })" class="btn btn-info">Ver</a>

                    <!-- Editar y Eliminar -->
                    <a href="@Url.Action("EditarAlbum", new { id = album.Code })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("EliminarAlbum", new { id = album.Code })" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
