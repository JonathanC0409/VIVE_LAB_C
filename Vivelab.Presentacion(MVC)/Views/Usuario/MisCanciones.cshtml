@model IEnumerable<Vivelab.Modelos.Cancion>

@{
    ViewData["Title"] = "Mis Canciones";
}

<link href="~/css/mis-canciones.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="mis-canciones-container">
    <h2 class="mis-canciones-title">@ViewData["Title"]</h2>

    <p>
        <a asp-action="Subir" asp-controller="Musica" class="btn-subir-cancion">
            <i class="bi bi-upload"></i> Subir nueva canción
        </a>
    </p>

    <table class="mis-canciones-table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Duración</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cancion in Model)
            {
                <tr>
                    <td>@cancion.Titulo</td>
                    <td>@cancion.Duracion.ToString(@"mm\:ss")</td>
                    <td>
                        <a href="@Url.Action("EditarCancion", new { id = cancion.Codigo })"
                           class="btn-accion btn-editar">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a href="@Url.Action("EliminarCancion", new { id = cancion.Codigo })"
                           class="btn-accion btn-eliminar">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>