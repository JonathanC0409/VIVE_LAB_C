@model Vivelab.Modelos.Album

@{
    ViewData["Title"] = "Editar Álbum";
}

<link href="~/css/editar-album.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="editar-album-container">
    <h1 class="editar-album-title">@ViewData["Title"]</h1>
    <h4 class="editar-album-subtitle">Editar Álbum</h4>
    <span class="title-separator"></span>

    <form asp-action="EditarAlbum" enctype="multipart/form-data" class="album-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Código del Álbum (oculto) -->
        <input asp-for="Codigo" type="hidden" value="@Model.Codigo" />

        <!-- Nombre del Álbum -->
        <div class="form-group">
            <label asp-for="Nombre" class="form-label">Nombre del Álbum</label>
            <input asp-for="Nombre" class="form-control" value="@Model.Nombre" required placeholder="Ej: Mi álbum mejorado" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <!-- Fecha de Creación (oculta) -->
        <input asp-for="FechaCreacion" type="hidden" value="@Model.FechaCreacion.ToString("yyyy-MM-dd")" />

        <!-- Portada del Álbum -->
        <div class="form-group">
            <label class="form-label">Portada del Álbum</label>
            <div class="file-input-container">
                <label for="PortadaUrl" class="file-input-label">
                    <i class="bi bi-image"></i> Cambiar imagen
                </label>
                <input asp-for="PortadaUrl" id="PortadaUrl" class="file-input" type="file" accept="image/*" />
                <span class="file-name" id="fileName"></span>
                <span asp-validation-for="PortadaUrl" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.PortadaUrl))
            {
                <div class="current-cover">
                    <h5 class="current-cover-title">Portada Actual:</h5>
                    <img src="@Model.PortadaUrl" alt="Portada" class="current-cover-image" />
                </div>
            }
        </div>

        <!-- Artista Código (oculto) -->
        <input asp-for="ArtistaCodigo" type="hidden" value="@Model.ArtistaCodigo" />

        <!-- Botones -->
        <div class="btn-container">
            <button type="submit" class="btn-guardar">
                <i class="bi bi-save"></i> Guardar Cambios
            </button>
            <a asp-action="MisAlbumes" class="btn-volver">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Mostrar nombre del archivo seleccionado
        document.getElementById('PortadaUrl').addEventListener('change', function(e) {
            const fileName = document.getElementById('fileName');
            if (this.files.length > 0) {
                fileName.textContent = this.files[0].name;
                fileName.style.display = 'block';
            } else {
                fileName.style.display = 'none';
            }
        });
    </script>
}