@{
    ViewData["Title"] = "Cuenta Bloqueada";
}

<link href="~/css/usuario-bloqueado.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="usuario-bloqueado-container">
    <div class="lock-icon">
        <i class="bi bi-shield-lock"></i>
    </div>

    <h2 class="usuario-bloqueado-title">
        <i class="bi bi-exclamation-octagon"></i> Tu cuenta ha sido bloqueada
    </h2>

    <div class="bloqueo-alert">
        <strong>Acceso restringido</strong>
        <p>
            Lo sentimos, pero tu cuenta ha sido bloqueada por razones de seguridad o por incumplimiento
            de nuestras políticas. Esto puede deberse a actividades sospechosas, violación de términos
            de servicio u otras razones de seguridad.
        </p>
        <p style="margin-top: 1rem;">
            Si crees que esto es un error o deseas más información, por favor contacta a nuestro equipo
            de soporte para resolver esta situación.
        </p>
    </div>

    <a href="mailto:soporte@vivelab.com" class="btn-contacto">
        <i class="bi bi-envelope"></i> Contactar soporte
    </a>
</div>

