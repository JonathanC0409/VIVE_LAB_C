@{
    ViewData["Title"] = "Vincular Usuario";
}

<link href="~/css/vincularUsuario.css" rel="stylesheet" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css" />

<div class="vincular-container">
    <h2>@ViewData["Title"]</h2>

    <form method="post" asp-action="VincularUsuario" class="vincular-form">
        <div class="form-group">
            <label for="EmailUsuarioVincular" class="form-label">
                <i class="bi bi-envelope"></i> Correo del Usuario a Vincular
            </label>
            <input type="email" class="form-control" id="EmailUsuarioVincular" name="emailUsuarioVincular"
                   placeholder="ejemplo@correo.com" required />
        </div>
        <button type="submit" class="btn-vincular">
            <i class="bi bi-link-45deg"></i> Vincular Usuario
        </button>
    </form>

    <!-- Mostrar mensaje de error con ViewBag -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert-message error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>¡Ups!</strong> @ViewBag.ErrorMessage
            </div>
        </div>
    }

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert-message success">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>¡Éxito!</strong> @ViewBag.SuccessMessage
            </div>
        </div>
    }

    <!-- Mostrar los usuarios vinculados como tarjetas estilizadas -->
    @if (ViewBag.UsuariosVinculados != null && ViewBag.UsuariosVinculados.Count > 0)
    {
        <h3>Usuarios Vinculados</h3>
        <div class="usuarios-vinculados-container">
            <div class="usuarios-grid">
                @foreach (var usuarioSuscripcion in ViewBag.UsuariosVinculados)
                {
                    <div class="usuario-card">
                        <div class="usuario-avatar avatar-color@(usuarioSuscripcion.UsuarioId % 6)">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="usuario-info">
                            <h5 class="usuario-nombre">@usuarioSuscripcion.Usuario.Nombre</h5>
                            <p class="usuario-email">
                                <i class="bi bi-envelope"></i> @usuarioSuscripcion.Usuario.Email
                            </p>
                            <p class="usuario-fecha">
                                <i class="bi bi-calendar-check"></i> Vinculado el: @usuarioSuscripcion.FechaVinculacion.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        <form method="post" asp-action="EliminarVinculacion"
                              onsubmit="return confirm('¿Estás seguro de eliminar esta vinculación?');">
                            <input type="hidden" name="usuarioId" value="@usuarioSuscripcion.UsuarioId" />
                            <button type="submit" class="btn-action">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
    else if (ViewBag.UsuariosVinculados != null)
    {
        <div class="alert-message info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>No hay usuarios vinculados</strong>
                <p>Comienza vinculando usuarios usando el formulario superior</p>
            </div>
        </div>
    }
</div>