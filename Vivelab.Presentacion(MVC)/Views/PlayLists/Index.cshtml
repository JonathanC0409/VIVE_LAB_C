@model List<Vivelab.Modelos.Playlist>

@{
    ViewData["Title"] = "Playlists";
}

<link href="~/css/playlists.css" rel="stylesheet" asp-append-version="true" />

<div class="playlists-container">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-notification">
            <i class="fas fa-info-circle"></i> @TempData["Mensaje"]
        </div>
    }

    @if (ViewBag.Plan != 0)
    {
        <div class="playlists-header">
            <h1 class="playlists-title">
                <i class="fas fa-music"></i> Tus Playlists
                <div class="title-underline"></div>
            </h1>

            <a href="@Url.Action("Create", "PlayLists")" class="btn-create-playlist">
                <i class="fas fa-plus"></i> Crear Nueva Playlist
            </a>
        </div>

        @if (Model.Count > 0)
        {
            <div class="playlists-grid">
                @foreach (var playlist in Model)
                {
                    <div class="playlist-card">
                        <div class="card-gradient"></div>
                        <div class="card-content">
                            <h3 class="playlist-name">@playlist.Nombre</h3>
                            <p class="playlist-description">Disfruta de tu selección personalizada</p>

                            <div class="playlist-actions">
                                <a href="@Url.Action("Details", "PlayLists", new { id = playlist.Codigo })" class="btn-action btn-view">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", "PlayLists", new { id = playlist.Codigo })" class="btn-action btn-edit">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <a href="@Url.Action("Delete", "PlayLists", new { id = playlist.Codigo })" class="btn-action btn-delete">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-playlists">
                <div class="empty-content">
                    <i class="fas fa-music"></i>
                    <h3>Aún no tienes playlists creadas</h3>
                    <p>¡Empieza una nueva ahora y organiza tu música favorita!</p>
                    <a href="@Url.Action("Create", "PlayLists")" class="btn-create">
                        <i class="fas fa-plus"></i> Crear mi primera playlist
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="upgrade-required">
            <div class="upgrade-content">
                <i class="fas fa-crown"></i>
                <h2>Función no disponible</h2>
                <p>Esta opción solo está disponible para usuarios con un plan activo.</p>
                <a href="@Url.Action("Index", "Plan")" class="btn-upgrade">
                    Actualizar mi Plan
                </a>
            </div>
        </div>
    }
</div>